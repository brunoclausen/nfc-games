# ACR122U: userspace CCID, not the kernel NFC stack.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="072f", ATTR{idProduct}=="2200", MODE="0666"
ACTION=="add", SUBSYSTEM=="usb", DRIVER=="pn533_usb", ATTRS{idVendor}=="072f", ATTRS{idProduct}=="2200", RUN+="/bin/sh -c 'echo -n %k > /sys/bus/usb/drivers/pn533_usb/unbind'"
