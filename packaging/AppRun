#!/bin/sh
# AppImage entry: install to ~/Applications, menu, autostart, udev, then run nfc.
set -e
HERE="$(dirname "$(readlink -f "$0")")"
export NFC_SHARE="${NFC_SHARE:-$HERE/usr/share/nfc-games}"

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/nfc-games"
mkdir -p "$CONF"
if [ -z "$NFC_TAGS" ]; then
  if [ ! -f "$CONF/tags.conf" ] && [ -f "$HOME/nfc-games/tags.conf" ]; then
    cp "$HOME/nfc-games/tags.conf" "$CONF/tags.conf"
  fi
  export NFC_TAGS="$CONF/tags.conf"
fi

# Prefer libraries bundled in the AppImage (libusb, libudev).
if [ -d "$HERE/usr/lib" ]; then
  export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
export PATH="$HERE/usr/bin:${PATH:-/usr/bin}"

NFC_DA=1
if [ "${NFC_LANG:-}" = "en" ]; then NFC_DA=0; fi
if [ -f "$CONF/nfc.conf" ]; then
  if grep -q '^lang=en' "$CONF/nfc.conf" 2>/dev/null; then NFC_DA=0; fi
  if grep -q '^lang=da' "$CONF/nfc.conf" 2>/dev/null; then NFC_DA=1; fi
fi

nfc_msg() {
  if [ "$NFC_DA" = 1 ]; then
    printf 'nfc: %s\n' "$1"
  else
    printf 'nfc: %s\n' "$2"
  fi
}

abspath() {
  readlink -f "$1" 2>/dev/null || printf '%s\n' "$1"
}

quote_exec() {
  case "$1" in
    *[!A-Za-z0-9_./:+-]*) printf '"%s"' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

INSTALL_DIR="$HOME/Applications"
INSTALL_NAME="nfc-games-x86_64.AppImage"
INSTALL_PATH="$HOME/Applications/nfc-games-x86_64.AppImage"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
ICON_DST="$DATA/icons/hicolor/256x256/apps/nfc-games.png"
DESKTOP_DST="$DATA/applications/nfc-games.desktop"
AUTOSTART_DST="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/nfc-games.desktop"
UNIT_DST="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/nfc-games.service"
BIN="$HERE/usr/bin/nfc"
EXTRA_ARGS="watch"

write_desktop() {
  dest="$1"
  terminal="$2"
  skip="$3"
  run_arg="$4"
  exec_line="$(quote_exec "$BIN")"
  if [ "$skip" = 1 ]; then
    exec_line="/usr/bin/env NFC_SKIP_INSTALL=1 $exec_line"
  fi
  if [ -n "$run_arg" ]; then
    exec_line="$exec_line $run_arg"
  fi
  mkdir -p "$(dirname "$dest")"
  {
    cat << EOF
[Desktop Entry]
Type=Application
Name=NFC Games
Name[da]=NFC-spil
Comment=Place an NFC tag on the reader to start a Steam game
Comment[da]=Læg et NFC-tag på læseren for at starte et Steam-spil
Exec=$exec_line
Icon=nfc-games
Terminal=$terminal
Categories=Game;
Keywords=nfc;steam;acr122u;tag;
StartupNotify=false
X-AppImage-Integrate=false
X-GNOME-Autostart-enabled=false
EOF
    q="$(quote_exec "$BIN")"
    if [ "$skip" = 1 ]; then
      q="/usr/bin/env NFC_SKIP_INSTALL=1 $q"
    fi
    cat << EOF
Actions=Listen;Menu;Tags;Restart;

[Desktop Action Listen]
Name=Listen for tags
Name[da]=Lyt efter tags
Exec=$q lyt

[Desktop Action Menu]
Name=Menu
Name[da]=Menu
Exec=$q menu

[Desktop Action Tags]
Name=Show tags
Name[da]=Vis tags
Exec=$q list

[Desktop Action Restart]
Name=Restart listener
Name[da]=Genstart lyt
Exec=$q restart
EOF
  } > "$dest"
}

copy_icon() {
  mkdir -p "$(dirname "$ICON_DST")"
  for ic in "$HERE/nfc-games.png" \
            "$HERE/usr/share/icons/hicolor/256x256/apps/nfc-games.png" \
            "$HERE/usr/share/pixmaps/nfc-games.png"; do
    if [ -f "$ic" ]; then
      cp -f "$ic" "$ICON_DST"
      return 0
    fi
  done
  return 0
}

stage_udev() {
  RULE_SRC="$NFC_SHARE/udev/99-acr122u.rules"
  HELPER_SRC="$NFC_SHARE/udev/install-udev.sh"
  [ -f "$RULE_SRC" ] && [ -f "$HELPER_SRC" ] || return 0
  UDEV_DIR="$CONF/udev"
  mkdir -p "$UDEV_DIR"
  cp -f "$RULE_SRC" "$UDEV_DIR/99-acr122u.rules"
  cp -f "$HELPER_SRC" "$UDEV_DIR/install-udev.sh"
  chmod 755 "$UDEV_DIR/install-udev.sh"
}

install_cli_wrapper() {
  mkdir -p "$HOME/bin"
  wrap="$HOME/bin/nfc"
  cat > "$wrap" << EOF
#!/bin/sh
APP='$INSTALL_PATH'
if [ ! -x "\$APP" ]; then
  echo "nfc: mangler \$APP" >&2
  exit 127
fi
case "\${1:-}" in
  install) exec "\$APP" "\$@" ;;
esac
if [ "\${1:-}" = "udev" ] && [ "\${2:-}" = "install" ]; then
  exec "\$APP" "\$@"
fi
export NFC_SKIP_INSTALL=1
exec "\$APP" "\$@"
EOF
  chmod +x "$wrap"
}

install_udev_if_needed() {
  [ "${NFC_SKIP_UDEV:-}" = "1" ] && return 0
  stage_udev || true
  RULE="$CONF/udev/99-acr122u.rules"
  HELPER="$CONF/udev/install-udev.sh"
  RULE_SRC="$NFC_SHARE/udev/99-acr122u.rules"
  [ -f "$RULE" ] && [ -f "$HELPER" ] || return 0

  need=0
  if [ ! -f /etc/udev/rules.d/99-acr122u.rules ]; then need=1; fi
  if [ ! -f /etc/modprobe.d/nfc-games-acr122u.conf ]; then need=1; fi
  if [ -f /etc/udev/rules.d/99-acr122u.rules ] && [ -f "$RULE_SRC" ]; then
    if ! cmp -s "$RULE_SRC" /etc/udev/rules.d/99-acr122u.rules; then need=1; fi
  fi
  [ "$need" = 1 ] || return 0

  nfc_msg "installerer ACR122U udev-regel (engang på denne PC)..." \
          "installing ACR122U udev rule (once on this PC)..."
  if [ "$(id -u)" = "0" ]; then
    "$HELPER" "$RULE" || true
  elif command -v pkexec >/dev/null 2>&1; then
    pkexec "$HELPER" "$RULE" || true
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$HELPER" "$RULE" || true
  else
    nfc_msg "kør: nfc udev install" "run: nfc udev install" >&2
  fi
}

self_install() {
  extra="watch"
  mkdir -p "$INSTALL_DIR"
  if [ -n "${APPIMAGE:-}" ]; then
    src="$(abspath "$APPIMAGE")"
    dst="$(abspath "$INSTALL_PATH")"
    if [ "$src" != "$dst" ] || [ ! -x "$INSTALL_PATH" ]; then
      if [ ! -f "$INSTALL_PATH" ] || ! cmp -s "$APPIMAGE" "$INSTALL_PATH"; then
        tmp="$INSTALL_PATH.$$"
        cp -f "$APPIMAGE" "$tmp"
        chmod +x "$tmp"
        mv -f "$tmp" "$INSTALL_PATH"
        COPIED=1
      fi
    fi
    if [ -x "$INSTALL_PATH" ]; then
      BIN="$INSTALL_PATH"
    else
      BIN="$APPIMAGE"
    fi
  fi

  copy_icon
  write_desktop "$DESKTOP_DST" true 1 "menu"
  install_cli_wrapper
  stage_udev || true
  # Login starter is the systemd user unit. Drop leftover XDG autostart.
  rm -f "$AUTOSTART_DST"

  mkdir -p "$(dirname "$UNIT_DST")"
  exec_q="$(quote_exec "$BIN")"
  start_cmd="$exec_q watch"
  cat > "$UNIT_DST" << EOF
[Unit]
Description=NFC Games ACR122U
After=graphical-session.target
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
Environment=NFC_SKIP_INSTALL=1
ExecStart=$start_cmd
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
EOF
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    systemctl --user enable nfc-games.service >/dev/null 2>&1 || true
    if [ "${1:-}" = "install" ]; then
      systemctl --user try-restart nfc-games.service >/dev/null 2>&1 || \
        systemctl --user start nfc-games.service >/dev/null 2>&1 || true
    else
      systemctl --user start nfc-games.service >/dev/null 2>&1 || true
    fi
  fi
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$DATA/applications" >/dev/null 2>&1 || true
  fi

  reexec=0
  if [ -n "${APPIMAGE:-}" ] && [ -x "$INSTALL_PATH" ]; then
    now="$(abspath "$INSTALL_PATH")"
    cur="$(abspath "$APPIMAGE")"
    if [ "$now" != "$cur" ]; then
      reexec=1
    fi
  fi
  if [ "$reexec" != 1 ]; then
    if [ "${COPIED:-0}" = 1 ] || [ "${1:-}" = "install" ]; then
      nfc_msg "installeret til $BIN" "installed to $BIN"
      nfc_msg "kommando: nfc  (via ~/bin/nfc → AppImage)" "command: nfc  (~/bin/nfc → AppImage)"
      nfc_msg "lytter ved login (grøn LED = klar)" "listens at login (green LED = ready)"
    fi
  fi
  if [ "$reexec" = 1 ]; then
    exec "$INSTALL_PATH" "$@"
  fi
}

# Skip AppImage runtime flags (extract, mount, ...).
case "${1:-}" in
  --appimage-*) ;;
  *)
    if [ "${1:-}" = "install" ] || [ "${NFC_SKIP_INSTALL:-}" != "1" ]; then
      COPIED=0
      self_install "$@" || true
      install_udev_if_needed || true
    fi
    ;;
esac

if [ "${1:-}" = "install" ]; then
  if [ -f /etc/udev/rules.d/99-acr122u.rules ]; then
    nfc_msg "udev-regel er installeret" "udev rule is installed"
  fi
  exit 0
fi

# No args: interactive menu. Login/autostart passes "watch".
if [ $# -eq 0 ]; then
  exec "$HERE/usr/bin/nfc" menu
fi

exec "$HERE/usr/bin/nfc" "$@"
